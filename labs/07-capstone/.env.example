# Copy to .env and choose backends. .env is gitignored. See labs/model-backends.md.

# --- Chat backend (the orchestrator; needs tool-calling) ---
MODEL_BACKEND=ollama
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# MODEL=llama3.1:8b

# --- Embeddings (defaults to local Ollama; Groq is chat-only, not listed) ---
EMBED_BACKEND=ollama
# EMBED_MODEL=nomic-embed-text

# --- Langfuse (optional — free tier at https://cloud.langfuse.com. Without
# these the agent still runs; you just won't see a trace dashboard.) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Cloud track (optional, NOT required, NOT run by this repo — see the
# README's "Cloud Track" section before touching this). If you deploy your own
# rented-GPU serving endpoint (vLLM/SGLang), it's still OpenAI-compatible, so
# it's just another MODEL_BACKEND base_url — no code changes needed. ---
# MODEL_BACKEND=openai
# OPENAI_BASE_URL=https://your-rented-gpu-endpoint/v1
