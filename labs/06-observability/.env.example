# Copy to .env and choose backends. .env is gitignored. See labs/model-backends.md.

# --- Chat backend ---
MODEL_BACKEND=ollama
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# MODEL=llama3.1:8b

# --- Embeddings (defaults to local Ollama; Groq is chat-only, not listed) ---
EMBED_BACKEND=ollama
# EMBED_MODEL=nomic-embed-text

# --- Langfuse (free tier at https://cloud.langfuse.com — sign up, create a
# project, copy the keys below). Without these the app still runs; you just
# won't see traces in a dashboard. ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
