# Copy to .env to change what this lab benchmarks. .env is gitignored.

# Comma-separated Ollama model tags to compare. Default: the same model at two
# quantization levels, to isolate the quantization effect (not model size).
MODELS=llama3.2:3b,llama3.2:3b-instruct-fp16

# How many times to run each prompt per model (averaged — first run per model
# pays a one-time model-load cost, excluded from the average; see bench.py).
RUNS=3

# Illustrative self-host cost input: $/hour for the GPU or instance you'd
# actually run this on. The default is a small cloud GPU instance rate —
# replace with your real rate before quoting a customer. See cost.py.
GPU_HOURLY_USD=0.50
